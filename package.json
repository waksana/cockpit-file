    "verify:package": "node scripts/verify-package.mjs"
  },
  "devDependencies": {
    "@cockpit/module-api": "file:.cockpit-sdk/module-api",
    "@types/node": "25.9.5",
    "@types/react": "19.2.18",
    "lucide-static": "1.46.0",
    "typescript": "5.9.3"
